---
interface Props { kind: 'web' | 'app' | 'flow' | 'agent'; title: string }
const { kind, title } = Astro.props;
const descriptions = {
  web: 'Un marco, una navegación y bloques de contenido construyen una interfaz.',
  app: 'Varios módulos se ensamblan dentro de una aplicación.',
  flow: 'Los datos recorren un flujo definido y activan su resultado.',
  agent: 'Una solicitud llega al agente, que interpreta información, consulta una herramienta y prepara un resultado.',
};
---
<button class:list={['service-diagram', `diagram--${kind}`]} type="button" disabled data-service-demo={kind} data-demo-state="idle" aria-label={`Reproducir demostración: ${title.replaceAll('\n', ' ')}`} aria-describedby={`service-demo-description-${kind}`}>
  <svg class="service-demo-art" viewBox="0 0 155 124" fill="none" aria-hidden="true" focusable="false">
    {kind === 'web' && <>
      <rect class="demo-paper" data-part="web-frame" x="24" y="24" width="107" height="77" rx="2" pathLength="1" />
      <path data-part="web-rule" d="M24 39H131" pathLength="1" />
      <g data-part="web-nav" class="demo-ink"><circle cx="31" cy="32" r="1" /><circle cx="36" cy="32" r="1" /><circle cx="41" cy="32" r="1" /><rect x="104" y="31" width="18" height="2" /></g>
      <rect data-part="web-line" class="demo-ink" x="34" y="50" width="47" height="5" />
      <rect data-part="web-line" class="demo-ink" x="34" y="60" width="36" height="3" />
      <rect data-part="web-line" class="demo-muted" x="34" y="69" width="42" height="2" />
      <g data-part="web-image"><rect class="demo-muted" x="94" y="50" width="27" height="35" rx="1" /><path class="demo-track" d="M94 74L104 63L111 70L121 59" /><circle class="demo-paper" cx="113" cy="58" r="3" /></g>
      <rect data-part="web-action" class="demo-signal" x="34" y="81" width="25" height="9" rx="1" />
    </>}
    {kind === 'app' && <>
      <rect data-part="app-frame" class="demo-paper" x="25" y="25" width="105" height="74" rx="2" pathLength="1" />
      <path data-part="app-divider" d="M49 25V99" pathLength="1" />
      <g data-part="app-navigation"><path d="M32 38H41M32 48H41M32 58H41" /><rect class="demo-ink" x="57" y="35" width="43" height="4" /></g>
      <g class="demo-guide"><rect x="57" y="49" width="18" height="35" rx="1" /><rect x="81" y="49" width="18" height="35" rx="1" /><rect x="105" y="49" width="18" height="35" rx="1" /></g>
      <g data-part="app-module"><rect class="demo-muted" x="57" y="49" width="18" height="35" rx="1" /><path d="M61 57H70M61 62H67" /></g>
      <g data-part="app-module"><rect class="demo-muted" x="81" y="49" width="18" height="35" rx="1" /><path d="M85 57H94M85 62H91" /></g>
      <g data-part="app-module"><rect class="demo-muted" x="105" y="49" width="18" height="35" rx="1" /><path d="M109 57H118M109 62H115" /></g>
      <g data-part="app-extension"><rect class="demo-signal" x="112" y="16" width="18" height="18" rx="2" /><path d="M117 25H125M121 21V29" /></g>
    </>}
    {kind === 'flow' && <>
      <path class="demo-track" d="M40 43H52Q58 43 58 49V69Q58 75 64 75H65M90 75H98Q104 75 104 69V50Q104 44 110 44H115" />
      <path data-part="flow-packet-a" class="demo-packet" pathLength="1" d="M40 43H52Q58 43 58 49V69Q58 75 64 75H65" />
      <path data-part="flow-packet-b" class="demo-packet" pathLength="1" d="M90 75H98Q104 75 104 69V50Q104 44 110 44H115" />
      <circle data-part="flow-pulse" class="demo-pulse" cx="28" cy="43" r="16" />
      <circle class="demo-ink" cx="28" cy="43" r="12" />
      <rect data-part="flow-middle" class="demo-paper" x="65" y="62" width="25" height="25" rx="4" />
      <path data-part="flow-process" d="M72 71H83M72 77H80" pathLength="1" />
      <rect data-part="flow-end" class="demo-result" x="115" y="32" width="25" height="25" rx="4" />
      <path data-part="flow-check" d="M122 44L126 48L133 40" pathLength="1" />
    </>}
    {kind === 'agent' && <>
      <path class="demo-track" d="M39 33H43Q49 33 49 39V53Q49 59 55 59H59M97 53H102Q108 53 108 47V40Q108 34 114 34H115M128 46V67Q128 73 122 73H97M78 75V94" />
      <path data-part="agent-incoming" class="demo-packet" pathLength="1" d="M39 33H43Q49 33 49 39V53Q49 59 55 59H59" />
      <path data-part="agent-call" class="demo-packet" pathLength="1" d="M97 53H102Q108 53 108 47V40Q108 34 114 34H115" />
      <path data-part="agent-return" class="demo-packet" pathLength="1" d="M128 46V67Q128 73 122 73H97" />
      <path data-part="agent-outgoing" class="demo-packet" pathLength="1" d="M78 75V94" />
      <rect class="demo-paper" x="17" y="23" width="22" height="20" rx="2" /><path d="M22 29H33M22 34H29" />
      <rect data-part="agent-core" class="demo-paper" x="59" y="43" width="38" height="32" rx="5" />
      <rect data-part="agent-interpret" class="demo-ink" x="68" y="52" width="11" height="2" />
      <rect data-part="agent-interpret" class="demo-ink" x="68" y="58" width="19" height="2" />
      <rect data-part="agent-interpret" class="demo-ink" x="68" y="64" width="15" height="2" />
      <rect data-part="agent-tool" class="demo-paper" x="115" y="22" width="25" height="24" rx="2" />
      <path d="M115 29H140M123 29V46" /><path data-part="agent-tool-data" d="M127 35H135M127 40H132" />
      <rect data-part="agent-result" class="demo-paper" x="67" y="94" width="24" height="20" rx="2" pathLength="1" />
      <rect data-part="agent-result-accent" class="demo-signal" x="71" y="99" width="16" height="2" />
      <path data-part="agent-result-line" d="M72 105H85" /><path data-part="agent-result-line" d="M72 109H81" />
    </>}
  </svg>
  <svg class="service-demo-replay" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><path d="M12.5 6A5 5 0 1 0 13 10M12.5 2.5V6H9" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" /></svg>
  <span id={`service-demo-description-${kind}`} class="sr-only">{descriptions[kind]}</span>
</button>
