---
import color from '../../public/brand/suplio-simbolo-color.svg?raw';
import light from '../../public/brand/suplio-simbolo-blanco.svg?raw';
interface Props { light?: boolean; class?: string; animated?: boolean }
const { light: isLight = false, class: className = '', animated = false } = Astro.props;
// Use the original SVG paths, viewBox and colors, with metadata omitted from markup only.
const source = (isLight ? light : color).replace(/<metadata>[\s\S]*?<\/metadata>/, '').replace(/<svg[^>]*>/, '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 96 96" aria-hidden="true" focusable="false">');
---
<span class:list={['brand-mark', className]} data-animated-mark={animated ? '' : undefined} set:html={source} />
