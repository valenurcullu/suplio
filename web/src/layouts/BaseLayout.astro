---
import spaceFont from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import interFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '../styles/global.css';
import SignatureIntro from '../components/SignatureIntro.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import WhatsAppLink from '../components/WhatsAppLink.astro';
import { isStaging, stripBase, withBase } from '../data/deploy';
interface Props { title?: string; description?: string; confirmation?: boolean }
const { confirmation = false } = Astro.props;
const canonical = new URL(stripBase(Astro.url.pathname), 'https://suplio.ar').href;
const title = Astro.props.title ?? 'Suplio — Soluciones tecnológicas para empresas';
const description = Astro.props.description ?? 'Diseñamos y desarrollamos webs, aplicaciones y automatizaciones según lo que necesita tu empresa. Desde la primera conversación hasta la implementación.';
const organization = { '@context': 'https://schema.org', '@type': 'Organization', name: 'Suplio', url: 'https://suplio.ar/', logo: 'https://suplio.ar/brand/suplio-horizontal-claro.svg', email: 'hola@suplio.ar', description };
---
<!doctype html><html lang="es-AR"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content="#F5F4F0" /><meta name="description" content={description} /><link rel="canonical" href={canonical} />{isStaging ? <meta name="robots" content="noindex, nofollow" /> : confirmation && <meta name="robots" content="noindex, follow" />}<link rel="icon" href={withBase('/brand/suplio-icono-oscuro.svg')} type="image/svg+xml" /><link rel="preload" href={spaceFont} as="font" type="font/woff2" crossorigin="anonymous" /><link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin="anonymous" /><title>{title}</title><meta property="og:type" content="website" /><meta property="og:locale" content="es_AR" /><meta property="og:site_name" content="Suplio" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:image" content="https://suplio.ar/images/og.png" /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="Suplio. Soluciones tecnológicas para empresas." /><meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content="https://suplio.ar/images/og.png" /><script type="application/ld+json" set:html={JSON.stringify(organization)} /></head><body>{!confirmation && <SignatureIntro />}<a class="skip-link" href="#contenido">Saltar al contenido</a><div id="inicio"></div>{!confirmation && <SiteHeader />}<main id="contenido"><slot /></main><SiteFooter />{!confirmation && <WhatsAppLink floating />}<script>import '../scripts/main';</script></body></html>
