---
import spaceFont from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import interFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
const title = 'Suplio — Soluciones tecnológicas para empresas';
const description = 'Diseñamos y desarrollamos webs, aplicaciones y automatizaciones según lo que necesita tu empresa. Desde la primera conversación hasta la implementación.';
const organization = { '@context': 'https://schema.org', '@type': 'Organization', name: 'Suplio', url: 'https://suplio.ar/', logo: 'https://suplio.ar/brand/suplio-horizontal-claro.svg', email: 'hola@suplio.ar', description };
---
<!doctype html><html lang="es-AR"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content="#F5F4F0" /><meta name="description" content={description} /><link rel="canonical" href="https://suplio.ar/" /><link rel="icon" href="/brand/suplio-icono-oscuro.svg" type="image/svg+xml" /><link rel="preload" href={spaceFont} as="font" type="font/woff2" crossorigin="anonymous" /><link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin="anonymous" /><title>{title}</title><meta property="og:type" content="website" /><meta property="og:locale" content="es_AR" /><meta property="og:site_name" content="Suplio" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content="https://suplio.ar/" /><meta property="og:image" content="https://suplio.ar/og.png" /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="Suplio. Soluciones tecnológicas para empresas." /><meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content="https://suplio.ar/og.png" /><script type="application/ld+json" set:html={JSON.stringify(organization)} /></head><body><a class="skip-link" href="#contenido">Saltar al contenido</a><div id="inicio"></div><SiteHeader /><main id="contenido"><slot /></main><SiteFooter /><script>import '../scripts/main';</script></body></html>
