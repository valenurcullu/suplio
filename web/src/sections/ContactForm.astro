---
import Arrow from '../components/Arrow.astro';
import WhatsAppLink from '../components/WhatsAppLink.astro';
import { isStaging, withBase } from '../data/deploy';
// Staging (GitHub Pages) has no form backend: no Netlify attributes and no real submissions.
const netlify = isStaging ? {} : { 'data-netlify': 'true', 'netlify-honeypot': 'bot-field' };
---
<section id="consulta" class="inquiry shell section-space" aria-labelledby="inquiry-title">
  <div class="inquiry-intro">
    <span class="eyebrow"><span class="section-dot" /> 05 / Tu consulta</span>
    <h2 id="inquiry-title">Contanos<br />un poco más.</h2>
    <p>No hace falta que tengas todo definido. Contanos qué tenés en mente y vemos cómo podemos ayudarte.</p>
    <WhatsAppLink />
  </div>
  <form class="inquiry-form" name="suplio-consultas" method="POST" action={withBase('/consulta-recibida/')} {...netlify} data-staging={isStaging ? '' : undefined} aria-labelledby="inquiry-title" aria-describedby="inquiry-required inquiry-privacy" data-contact-form>
    <input type="hidden" name="form-name" value="suplio-consultas" />
    <p hidden><label>No completar este campo: <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
    {isStaging && <p class="inquiry-hint"><strong>Entorno de prueba:</strong> este formulario no envía consultas. Para escribirnos, usá <a href="mailto:hola@suplio.ar">hola@suplio.ar</a>.</p>}
    <p id="inquiry-required" class="inquiry-hint">Los campos con * son obligatorios.</p>
    <div class="inquiry-fields">
      <div class="inquiry-field"><label for="inquiry-name">Nombre y apellido <span aria-hidden="true">*</span></label><input id="inquiry-name" name="name" autocomplete="name" required maxlength="120" aria-describedby="inquiry-name-error" /><span id="inquiry-name-error" class="field-error" hidden></span></div>
      <div class="inquiry-field"><label for="inquiry-email">Email <span aria-hidden="true">*</span></label><input id="inquiry-email" name="email" type="email" autocomplete="email" required maxlength="254" aria-describedby="inquiry-email-error" /><span id="inquiry-email-error" class="field-error" hidden></span></div>
      <div class="inquiry-field"><label for="inquiry-company">Empresa <span class="field-optional">(opcional)</span></label><input id="inquiry-company" name="company" autocomplete="organization" maxlength="160" /></div>
      <div class="inquiry-field"><label for="inquiry-project">Tipo de proyecto <span class="field-optional">(opcional)</span></label><select id="inquiry-project" name="project-type"><option value="">Seleccioná una opción</option><option>Desarrollo web</option><option>Aplicaciones y software a medida</option><option>Automatización de procesos</option><option>IA y agentes</option><option>No estoy seguro todavía</option></select></div>
      <div class="inquiry-field inquiry-field--wide"><label for="inquiry-message">Mensaje <span aria-hidden="true">*</span></label><textarea id="inquiry-message" name="message" rows="4" required maxlength="5000" aria-describedby="inquiry-message-error"></textarea><span id="inquiry-message-error" class="field-error" hidden></span></div>
    </div>
    <p id="inquiry-privacy" class="inquiry-privacy">Usamos tus datos para responder esta consulta y conversar sobre tu proyecto. El envío se procesa a través de Netlify Forms. Evitá incluir contraseñas o información sensible. Para consultar sobre tus datos, escribinos a <a href="mailto:hola@suplio.ar">hola@suplio.ar</a>.</p>
    <div class="inquiry-actions"><button class="inquiry-submit" type="submit" disabled={isStaging}><span data-submit-label>Enviar consulta</span><Arrow /></button><span class="inquiry-status" role="status" aria-live="polite" data-submit-status></span></div>
    <p class="inquiry-feedback" role="alert" tabindex="-1" data-submit-error hidden></p>
    <noscript><p class="inquiry-hint">Al enviar, vas a ver la confirmación en una nueva página. Si aparece un error, volvé a este formulario o escribinos a <a href="mailto:hola@suplio.ar">hola@suplio.ar</a>.</p></noscript>
  </form>
</section>
<script>import '../scripts/contact';</script>
<style>
  .inquiry { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.35fr); gap: clamp(48px, 7vw, 120px); background: var(--paper); }
  .inquiry-intro h2 { font-size: clamp(36px, 4.1vw, 62px); line-height: 1.06; letter-spacing: -.055em; margin-block: 34px 24px; }
  .inquiry-intro > p { max-width: 310px; font-size: 15px; line-height: 1.8; color: var(--muted); }
  .inquiry-intro :global(.whatsapp-inline) { margin-top: 36px; }
  .inquiry-form { min-width: 0; }
  .inquiry-hint { font-size: 11px; color: var(--muted); line-height: 1.7; margin-bottom: 32px; }
  .inquiry-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 28px; row-gap: 32px; }
  .inquiry-field { min-width: 0; }
  .inquiry-field--wide { grid-column: 1 / -1; }
  .inquiry-field label { display: block; font-family: var(--display); font-size: 13px; margin-bottom: 10px; }
  .field-optional { color: var(--muted); font-family: var(--body); font-size: 10px; }
  .inquiry-field input, .inquiry-field select, .inquiry-field textarea { display: block; width: 100%; min-width: 0; min-height: 46px; padding: 10px 0; border: 0; border-bottom: 1px solid #e3e0d8; border-radius: 0; background: transparent; color: var(--ink); font: 400 16px/1.6 var(--body); transition: border-color .2s; }
  .inquiry-field select { text-overflow: ellipsis; padding-right: 20px; }
  .inquiry-field textarea { resize: vertical; min-height: 130px; }
  .inquiry-field input:focus, .inquiry-field select:focus, .inquiry-field textarea:focus { outline: 2px solid var(--ink); outline-offset: 5px; border-bottom-color: var(--orange); }
  .inquiry-field [aria-invalid='true'] { border-bottom: 2px solid #9d3416; }
  .field-error { display: block; color: #9d3416; font-size: 12px; line-height: 1.6; margin-top: 10px; }
  .field-error[hidden] { display: none; }
  .inquiry-privacy { margin-block: 28px; font-size: 11px; line-height: 1.8; color: var(--muted); }
  .inquiry-privacy a, .inquiry-hint a { text-decoration: underline; text-underline-offset: 3px; }
  .inquiry-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 16px; }
  .inquiry-submit { display: inline-flex; align-items: center; justify-content: space-between; gap: 40px; background: var(--ink); color: var(--paper); border: 1px solid var(--ink); padding: 20px 24px; font-family: var(--display); font-size: 14px; transition: background .2s; }
  .inquiry-submit :global(.arrow) { color: var(--orange); width: 19px; height: 19px; }
  .inquiry-submit:hover:not(:disabled) :global(.arrow) { transform: translate(2px, -2px); }
  .inquiry-submit:focus-visible { outline-color: var(--ink); }
  .inquiry-submit:disabled { cursor: wait; opacity: .75; }
  .inquiry-status { color: var(--muted); font-size: 12px; }
  .inquiry-feedback { margin-top: 24px; font-size: 13px; line-height: 1.7; color: #9d3416; }
  @media (max-width: 1050px) { .inquiry { grid-template-columns: minmax(0, .75fr) minmax(0, 1.25fr); gap: 40px; } .inquiry-fields { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 699px) { .inquiry { grid-template-columns: minmax(0, 1fr); gap: 44px; padding-block: 64px; } .inquiry-intro h2 { margin-top: 26px; } .inquiry-intro > p { max-width: 360px; font-size: 14px; } .inquiry-submit { width: 100%; } }
</style>
