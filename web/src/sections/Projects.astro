---
import BrandMark from '../components/BrandMark.astro';
import { projects } from '../data/projects';
import ProjectCase from '../components/ProjectCase.astro';
---
<section id="proyectos" class="projects section-space" aria-labelledby="projects-title"><div class="shell">
  <div class="projects-intro"><div class="section-heading section-heading--dark projects-heading"><span class="eyebrow"><span class="section-dot" /> 03 / Proyectos</span><h2 id="projects-title" data-reveal>Del problema<br />a lo concreto.</h2><p>Un espacio para mostrar<br />lo que construimos.</p></div>
    <div class="projects-brand" data-project-identity aria-hidden="true">
      <BrandMark class="projects-brand__mark" light />
      <div class="projects-brand__canvas" data-identity-canvas></div>
    </div>
  </div>
  {projects.map(project => <ProjectCase project={project} />)}
</div></section>

<style>
  .projects-intro { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); align-items: center; gap: clamp(32px, 5vw, 80px); margin-bottom: 64px; }
  .projects-heading { display: block; margin-bottom: 0; }
  .projects-heading > .eyebrow { padding-top: 0; margin-bottom: 30px; }
  .projects-heading > p { margin-top: 25px; }
  .projects-brand { position: relative; display: grid; place-items: center; min-width: 0; width: 100%; height: clamp(280px, 29vw, 370px); }
  .projects-brand :global(.projects-brand__mark) { width: clamp(180px, 21vw, 265px); }
  .projects-brand__canvas { position: absolute; inset: 0; opacity: 0; pointer-events: none; }
  .projects-brand__canvas :global(canvas) { display: block; width: 100%; height: 100%; }
  @media (max-width: 899px) {
    .projects-intro { grid-template-columns: minmax(0, 1fr); gap: 20px; margin-bottom: 40px; }
    .projects-heading { margin-bottom: 0; }
    .projects-brand { height: 260px; max-width: 440px; justify-self: center; }
    .projects-brand :global(.projects-brand__mark) { width: 205px; }
  }
  @media (max-width: 539px) {
    .projects-intro { gap: 12px; margin-bottom: 32px; }
    .projects-brand { height: 230px; }
    .projects-brand :global(.projects-brand__mark) { width: 180px; }
  }
</style>
