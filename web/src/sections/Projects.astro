---
import { projects } from '../data/projects';
import ProjectCase from '../components/ProjectCase.astro';
---
<section id="proyectos" class="projects section-space" aria-labelledby="projects-title"><div class="shell">
  <div class="section-heading section-heading--dark"><span class="eyebrow"><span class="section-dot" /> 03 / Proyectos</span><h2 id="projects-title" data-reveal>Del problema<br />a lo concreto.</h2><p>Un espacio para mostrar<br />lo que construimos.</p></div>
  {projects.map(project => <ProjectCase project={project} />)}
</div></section>
